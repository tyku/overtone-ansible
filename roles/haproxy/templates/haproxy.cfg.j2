# Managed by Ansible. TLS termination is intentionally not configured here.
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    timeout connect 5s
    timeout client 50s
    timeout server 50s

frontend http_in
    bind *:{{ haproxy_http_port }}
    default_backend workers_http

backend workers_http
    balance roundrobin
{% for worker in haproxy_backend_hosts %}
    server {{ worker }} {{ hostvars[worker].private_ip }}:{{ haproxy_backend_http_port }} check inter {{ haproxy_backend_check_interval }}
{% endfor %}

frontend https_in
    bind *:{{ haproxy_https_port }}
    default_backend workers_https

backend workers_https
    balance roundrobin
{% for worker in haproxy_backend_hosts %}
    server {{ worker }} {{ hostvars[worker].private_ip }}:{{ haproxy_backend_https_port }} check inter {{ haproxy_backend_check_interval }}
{% endfor %}

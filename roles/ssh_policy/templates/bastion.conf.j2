# Managed by Ansible: restricted SSH gateway policy.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no

AllowTcpForwarding local
DisableForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitOpen{% for host in groups['internal'] %} {{ hostvars[host].private_ip }}:22{% endfor %}{% for account in postgresql_access_users | default([]) if (account.state | default('present')) == 'present' %} {{ account.private_host }}:5432{% endfor %}{% for host in groups['swarm_workers'] %} {{ hostvars[host].private_ip }}:{{ admin_gateway_port }}{% endfor %} {{ hostvars[groups['swarm_managers'][0]].private_ip }}:{{ kuma_port }}

AllowUsers {{ ssh_policy_effective_allowed_users | join(' ') }}
